# Application
APP_NAME=BookOps AI
ENVIRONMENT=development
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080

# Database: local Docker Compose value
DATABASE_URL=postgresql+psycopg://bookops:bookops_password@db:5432/bookops
POSTGRES_DB=bookops
POSTGRES_USER=bookops
POSTGRES_PASSWORD=bookops_password

# Change every credential before production
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
ADMIN_EMAIL=owner@bookops.local
ADMIN_PASSWORD=ChangeMe123!

# Business
BUSINESS_NAME=BookOps Demo Salon
BUSINESS_TIMEZONE=Asia/Jerusalem
REMINDER_MINUTES=60
DAILY_SUMMARY_HOUR=19

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
